TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o

GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
# On Railway set GOOGLE_SERVICE_ACCOUNT_JSON to the full JSON in service Variables.
# Leave it unset for local file-based authentication.
GOOGLE_SPREADSHEET_ID=REPLACE_WITH_SPREADSHEET_ID
GOOGLE_WORKSHEET_NAME=Расходы

# Numeric Telegram user IDs; private chats only. Replace both examples.
ALLOWED_USER_IDS=123456789,987654321
# Report recipients must also be in ALLOWED_USER_IDS and have sent /start.
REPORT_CHAT_IDS=123456789

TIMEZONE=Asia/Dushanbe
CURRENCY=TJS
REPORT_HOUR=23
REPORT_MINUTE=0
# false: today's expenses; true: previous calendar day (e.g. report at 00:05).
REPORT_PREVIOUS_DAY=false

SQLITE_PATH=data/bot.sqlite3
MAX_IMAGE_MB=10
MAX_EXPENSES=50
MAX_JOB_ATTEMPTS=5
MAX_PENDING_JOBS=100
OPENAI_TIMEOUT_SECONDS=90
GOOGLE_TIMEOUT_SECONDS=30
