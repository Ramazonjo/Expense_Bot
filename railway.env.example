# Copy these SETTINGS to Railway > service > Variables, then replace placeholders.
# Add GOOGLE_SERVICE_ACCOUNT_JSON separately: paste the full original JSON value.
# Do not put real secrets in this file or in GitHub.
BOT_MODE=run
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o
GOOGLE_SPREADSHEET_ID=REPLACE_WITH_SPREADSHEET_ID
GOOGLE_WORKSHEET_NAME=Расходы
ALLOWED_USER_IDS=123456789
REPORT_CHAT_IDS=123456789
TIMEZONE=Asia/Dushanbe
CURRENCY=TJS
REPORT_HOUR=23
REPORT_MINUTE=0
REPORT_PREVIOUS_DAY=false
SQLITE_PATH=/data/bot.sqlite3
# Required for the existing non-root Docker image to write to Railway's root-owned Volume.
RAILWAY_RUN_UID=0
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=240
